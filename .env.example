# Required when DeepSeek Harness sends a real model request.
DEEPSEEK_API_KEY=

# Optional endpoint override.
# DEEPSEEK_BASE_URL=

# Optional CyberEinstein capability switch. Deep Research uses the same DSH
# model route and does not require a second model credential.
CYBEREINSTEIN_DEEP_RESEARCH_ENABLED=true

# Research-source credentials do not belong in this model-provider file.
# Use config/pragent-sources.env.example for PRAgent paper adapters.
