# OpenAlex permits a few anonymous demo calls, but real use should have a free key.
# Create one at https://openalex.org/settings/api and keep the populated file local.
OPENALEX_API_KEY=

# Optional compatible endpoint override, mainly for tests or an institutional proxy.
# OPENALEX_BASE_URL=https://api.openalex.org

# Successful responses are cached locally so repeated maps remain reproducible and
# transient provider failures do not erase already retrieved literature.
# OPENALEX_CACHE_DIR=.cybereinstein/cache/openalex
