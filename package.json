{
  "name": "cybereinstein",
  "version": "0.1.0",
  "private": true,
  "description": "An evidence-native AI scientist built on the Executable History of Science.",
  "license": "Apache-2.0",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "scripts": {
    "dsh:version": "dsh --version",
    "dsh:check": "DSH_HOME=.cybereinstein/dsh-home dsh --profile headless --dump-config",
    "dsh:web": "DSH_HOME=.cybereinstein/dsh-home dsh web",
    "dsh:headless": "DSH_HOME=.cybereinstein/dsh-home dsh --profile headless",
    "setup": "node scripts/setup-cybereinstein.mjs",
    "pragent:sources:setup": "node scripts/setup-pragent-sources.mjs",
    "pragent:sources:check": "node scripts/probe-pragent-sources.mjs",
    "pragent:sources:smoke": "node scripts/probe-pragent-sources.mjs --live",
    "deep-research:setup": "node scripts/setup-deep-literature-research.mjs",
    "deep-research:check": "node scripts/check-deep-literature-research.mjs",
    "reproduction-case:setup": "node scripts/setup-reproduction-case.mjs",
    "field-history:setup": "node scripts/setup-field-history.mjs",
    "field-history:build": "node scripts/build-field-history.mjs",
    "field-history:ablation": "node scripts/run-field-history-ablation.mjs",
    "field-history:benchmark": "node scripts/run-field-history-benchmark.mjs",
    "test": "pnpm run dsh:check && node --test tests/*.test.mjs"
  },
  "dependencies": {
    "@deepseek-ai/dsh": "0.1.1-rc.2"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "ajv": "8.20.0"
  }
}
